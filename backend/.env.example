# Optional. Both have working defaults — this file is only needed to override them.
# See docs/spec.md §11 for reproducibility notes.

# Hugging Face model id for the sentence-embedding model used for semantic
# ranking and evidence extraction. Default: intfloat/multilingual-e5-base
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# Pin a specific Hugging Face Hub revision (commit SHA or tag) for
# bit-for-bit reproducibility across time. Default: unset (resolves the
# model repo's default branch at load time).
EMBEDDING_MODEL_REVISION=

# Chat assistant (POST /api/v1/chat) — optional. Without LLM_API_KEY the
# structured search (POST /api/v1/recommend) and the web UI's manual search
# work exactly the same; only the chat panel reports "not configured".
# Provider: any OpenAI-compatible Chat Completions API (OpenAI itself, or a
# compatible gateway via LLM_BASE_URL).
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only needed for a non-default API base (e.g. OpenAI-compatible gateway).
LLM_BASE_URL=
