# Leave empty to use the bundled anonymized catalog (no backend required).
# Set the full endpoint URL to enable a single POST with SelectionRequest JSON.
# Example: VITE_RECOMMENDATIONS_URL=http://localhost:8000/api/recommendations
VITE_RECOMMENDATIONS_URL=

# Optional remote agent API base. Empty uses the Vite proxy /api/agent.
VITE_AGENT_API_URL=
# Server variables belong in .env.server, never in VITE_*.
# OPENAI_API_KEY=your_key
# OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# AGENT_PORT=8787
