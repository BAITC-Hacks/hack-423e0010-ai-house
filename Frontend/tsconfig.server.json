{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "noEmit": true, "strict": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["server", "src/domain", "src/services/demo.ts", "src/data"]
}
